snippet c C/C++ build artifacts
	# Object files
	*.o
	*.obj

	# Static libraries
	*.a
	*.lib

	# Shared libraries
	*.so
	*.so.*
	*.dll
	*.dylib

	# Executables
	*.exe
	*.out
	*.app

	# Debug files
	*.dSYM/
	*.su
	*.idb
	*.pdb

snippet build Build directories
	# Build directories
	build/
	Build/
	BUILD/
	dist/
	target/
	out/
	bin/
	obj/

snippet temp Temporary files
	# Temporary files
	*.tmp
	*.temp
	*.swp
	*.swo
	*~
	.*.sw[a-p]
	.DS_Store
	Thumbs.db

snippet python Python artifacts
	# Python
	__pycache__/
	*.py[cod]
	*\$py.class
	*.so
	.Python
	env/
	venv/
	ENV/
	build/
	develop-eggs/
	dist/
	downloads/
	eggs/
	.eggs/
	lib/
	lib64/
	parts/
	sdist/
	var/
	wheels/
	*.egg-info/
	.installed.cfg
	*.egg
	*.whl

snippet node Node.js artifacts
	# Node.js
	node_modules/
	npm-debug.log*
	yarn-debug.log*
	yarn-error.log*
	package-lock.json
	.npm
	.yarn-integrity

snippet ide IDE and editor files
	# IDE and editor files
	.vscode/
	.idea/
	*.iml
	*.ipr
	*.iws
	.project
	.classpath
	.settings/
	*.sublime-project
