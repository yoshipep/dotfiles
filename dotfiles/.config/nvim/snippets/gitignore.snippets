snippet full Complete gitignore template
	# Build artifacts
	*.o
	*.obj
	*.a
	*.lib
	*.so
	*.so.*
	*.dll
	*.exe
	*.out

	# Build directories
	build/
	dist/
	bin/
	obj/
	target/

	# Temporary files
	*.tmp
	*.temp
	*.swp
	*.swo
	*~
	*.bak
	*.log
	.DS_Store
	Thumbs.db

	# IDE files
	.vscode/
	.idea/
	*.iml

	# Language specific
