{
    "layer": "top",
    "position": "top",
    "height": 30,

    "modules-left": ["sway/workspaces", "custom/todo"],
    "modules-center": ["sway/mode"],
    "modules-right": ["network", "memory", "battery", "custom/firewall", "custom/docker", "pulseaudio", "custom/ip", "custom/hostname", "clock#time"],

    "sway/mode": {
        "format": " {} "
    },

    "network": {
        "interval": 5,
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "on-click": "$HOME/scripts/wifi-menu.sh",
        "tooltip-format-wifi": "{essid}",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "Disconnected"
    },

    "custom/todo": {
        "exec": "$HOME/.config/waybar/scripts/todo/todo.sh",
        "return-type": "json",
        "interval": 5,
        "signal": 8,
        "on-click": "$HOME/.config/waybar/scripts/todo/todo.sh mark_done",
        "on-click-right": "$HOME/.config/waybar/scripts/todo/todo.sh open_tui",
        "on-click-middle": "$HOME/.config/waybar/scripts/todo/todo.sh middle_click",
        "tooltip": true
    },

    "sway/workspaces": {
        "disable-scroll": false,
        "all-outputs": false,
        "format": "{name}"
    },

    "memory": {
        "interval": 5,
        "format": "󰍛 {used:0.1f}G",
        "tooltip-format": "{used:0.1f}G used / {total:0.1f}G total\n{percentage}%"
    },

    "battery": {
        "interval": 30,
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{time}",
        "states": {
            "warning": 30,
            "critical": 15
        }
    },

    "custom/firewall": {
        "exec": "$HOME/scripts/waybar_fw_status.sh",
        "return-type": "json",
        "interval": 5,
        "signal": 9,
        "tooltip": true
    },

    "custom/docker": {
        "exec": "$HOME/scripts/waybar_docker_status.sh",
        "return-type": "json",
        "interval": 5,
        "signal": 10,
        "tooltip": true
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "tooltip-format": "{volume}%",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "custom/ip": {
        "exec": "$HOME/scripts/waybar_ip.sh",
        "return-type": "json",
        "interval": 10,
        "signal": 1,
        "tooltip": false,
        "format": "{}"
    },

    "custom/hostname": {
        "exec": "h=$(hostname -s); printf '{\"text\":\"%s\"}' \"$h\"",
        "return-type": "json",
        "interval": "once",
        "tooltip": false,
        "format": " {} "
    },

    "clock#time": {
        "format": "{:%d/%m/%Y %H:%M}",
        "interval": 1,
        "locale": "en_GB.UTF-8",
        "tooltip-format": "<span font_family='Agave Nerd Font'>{calendar}</span>",
        "on-click": "$HOME/scripts/time-menu.sh",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 2,
            "weeks-pos": "left",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ebdbb2'><b>{}</b></span>",
                "weekdays": "<span color='#83a598'><b>{}</b></span>",
                "weeks": "<span color='#8ec07c'>W{}</span>",
                "days": "<span color='#d5c4a1'>{}</span>",
                "today": "<span color='#fabd2f'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_down",
            "on-scroll-down": "shift_up"
        }
    }
}
